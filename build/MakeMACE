
.PHONY: clean_mace mace_setup mace

 FTorch_DIR = /home/camille/software/FTorchbin
 DVODE_DIR = /STER/hydroModels/camille/phantom/macetraining/MACE/MACE_fortran/dvode

 DOBJS := $(DVODE_DIR)/src/dvode_kinds_module.F90 \
          $(DVODE_DIR)/src/dvode_blas_module.F90 \
          $(DVODE_DIR)/src/dvode_linpack_module.F90 \
          $(DVODE_DIR)/src/dvode_module.F90

mace_setup:
	@echo "setup of MACE files not implemented"

mace:
	@echo "Compiling DVODE..." 
	mkdir -p ${DVODE_DIR}/build
	cd ${DVODE_DIR}/build && $(FC) -c ${DOBJS}
	ar rcs $(DVODE_DIR)/build/libdvode.a \
	$(DVODE_DIR)/build/dvode_kinds_module.o \
	$(DVODE_DIR)/build/dvode_blas_module.o \
	$(DVODE_DIR)/build/dvode_linpack_module.o \
	$(DVODE_DIR)/build/dvode_module.o

	mkdir -p ${DVODE_DIR}/lib
	cp ${DVODE_DIR}/build/*.o ${DVODE_DIR}/lib
	cp ${DVODE_DIR}/build/*.a ${DVODE_DIR}/lib
	mkdir -p ${DVODE_DIR}/include
	cp ${DVODE_DIR}/build/*.mod ${DVODE_DIR}/include
	@echo "		Done!"



clean_mace:
	@echo "cleaning of MACE files not implemented"
